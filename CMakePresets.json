{
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 0
    },
    "configurePresets": [
        {
            "name": "Development",
            "displayName": "Development configuration",
            "description": "Development config using Ninja",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE":"RelWithDebInfo",
                "BUILD_TESTING": false
            }
        },
        {
            "name": "Release",
            "displayName": "Release config",
            "description": "Release config using Ninja",
            "inherits": "Development",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE":"Release",
                "BUILD_TESTING": false
            }
        },
        {
            "name": "Debug",
            "displayName": "Debug configuration",
            "description": "Debug config using Ninja",
            "inherits": "Development",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE":"Debug",
                "ASCHLLM_SYNC_AFTER_LAUNCH":"ON",
                "BUILD_TESTING": true
            }
        },
        {
            "name": "Sanitize",
            "displayName": "Debug + compute-sanitizer",
            "inherits": "Debug",
            "cacheVariables": {
                "CMAKE_TEST_LAUNCHER": "compute-sanitizer;--tool=memcheck;--leak-check=full;--error-exitcode=1;--require-cuda-init=no"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Development",
            "configurePreset": "Development"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Sanitize",
            "configurePreset": "Sanitize"
        }
    ],
    "testPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug",
            "inheritConfigureEnvironment": true,
            "output": {
                "verbosity": "verbose",
                "outputOnFailure": true
            }
        },
        {
            "name": "Sanitize",
            "inherits": "Debug",
            "configurePreset": "Sanitize"
        }
    ],
    "workflowPresets": [
        {
            "name": "Development",
            "steps": [
                {
                    "type": "configure",
                    "name": "Development"
                },
                {
                    "type": "build",
                    "name": "Development"
                }
            ]
        },
        {
            "name": "Release",
            "steps": [
                {
                    "type": "configure",
                    "name": "Release"
                },
                {
                    "type": "build",
                    "name": "Release"
                }
            ]
        },
        {
            "name": "Debug",
            "steps": [
                {
                    "type": "configure",
                    "name": "Debug"
                },
                {
                    "type": "build",
                    "name": "Debug"
                },
                {
                    "type": "test",
                    "name": "Debug"
                }
            ]
        }
    ]
}