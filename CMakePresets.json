{
    "version": 10,
    "cmakeMinimumRequired": {
        "major": 4,
        "minor": 0
    },
    "configurePresets": [
        {
            "name": "Development",
            "displayName": "Development configuration",
            "description": "Development config using Ninja",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE":"RelWithDebInfo"
            }
        },
        {
            "name": "Release",
            "displayName": "Release config",
            "description": "Release config using Ninja",
            "inherits": "Development",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE":"Release"
            }
        },
        {
            "name": "Debug",
            "displayName": "Debug configuration",
            "description": "Debug config using Ninja",
            "inherits": "Development",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE":"Debug",
                "ASCHLLM_SYNC_AFTER_LAUNCH":"ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Development",
            "configurePreset": "Development"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "Debug",
            "configurePreset": "Debug"
        }
    ],

    "workflowPresets": [
        {
            "name": "Development",
            "steps": [
                {
                    "type": "configure",
                    "name": "Development"
                },
                {
                    "type": "build",
                    "name": "Development"
                }
            ]
        },
        {
            "name": "Release",
            "steps": [
                {
                    "type": "configure",
                    "name": "Release"
                },
                {
                    "type": "build",
                    "name": "Release"
                }
            ]
        },
        {
            "name": "Debug",
            "steps": [
                {
                    "type": "configure",
                    "name": "Debug"
                },
                {
                    "type": "build",
                    "name": "Debug"
                }
            ]
        }
    ]
}